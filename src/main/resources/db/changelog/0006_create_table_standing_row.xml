<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0006_1" author="Matt">
        <createTable tableName="standing_row">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="standing_id" type="bigint">
                <constraints foreignKeyName="con_standingrow_standing"
                             referencedTableName="standing"
                             referencedColumnNames="standing_id"/>
            </column>
            <column name="team_id" type="bigint">
                <constraints foreignKeyName="con_standinrrow_team"
                             referencedTableName="teams"
                             referencedColumnNames="id"/>
            </column>
            <column name="position" type="int"/>
            <column name="played_games" type="int"/>
            <column name="won" type="int"/>
            <column name="draw" type="int"/>
            <column name="lost" type="int"/>
            <column name="points" type="int"/>
            <column name="goals_for" type="int"/>
            <column name="goals_against" type="int"/>
            <column name="goal_difference" type="int"/>

        </createTable>

    </changeSet>
</databaseChangeLog>